# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kiroku?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# App URL (used for Google OAuth callback)
# In production on Vercel, set this to https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 (Optional - for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Optional - for avatar & banner uploads on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
