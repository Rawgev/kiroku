# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ─────────────────────────────────────────
# Go to https://cloud.mongodb.com → Connect → Drivers → copy URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Kiroku?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Session (used only during OAuth dance) ────────────────
SESSION_SECRET=change_this_to_another_long_random_string

# ─── Frontend URL (for CORS + OAuth redirect) ──────────────
CLIENT_URL=http://localhost:5173

# ─── Google OAuth ──────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
